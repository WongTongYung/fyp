# Model weights (large files)
*.pt
*.pth
*.onnx
*.weights

# Allow the final trained model only
!models/best26m-improved4.pt

# Video files
*.mp4
*.avi
*.mov

# Binary / runtime artifacts
*.dll
*.db
*.db-shm
*.db-wal
*.bin

# Training runs (large outputs)
runs/

# Extracted frames (generated, large)
training/frames/
training/frames_TrainSet/

# Dataset directories (large)
training/dataset/
training/pickleball.*/
Pickleball*/

# Large runtime and training assets (local only)
assets/rewind/
assets/trainingData/

# Court calibration (user-specific, must recalibrate per setup)
data/court.json

# Python
__pycache__/
*.pyc
*.pyo

# Environment
.env
venv/

# OS
Thumbs.db
.DS_Store

# Report documents
docs/
